# SERVER SECRETS ONLY. Copy locally to supabase/.env (never commit).
# SUPABASE_URL and SUPABASE_SECRET_KEYS are supplied by hosted Edge Functions.
# Legacy SUPABASE_SERVICE_ROLE_KEY remains supported; never copy a server key to Flutter.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional separate tested model; defaults to OPENAI_MODEL if blank.
OPENAI_SAFETY_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Native ElevenLabs Agents configuration for WebRTC calls; no custom OpenAI bridge.
ELEVENLABS_AGENT_ID=
# Setup-time voice used by aira-voice-setup configure-native; Jessica is the current choice.
ELEVENLABS_REALTIME_VOICE_ID=
# Prompt/model/voice are saved inside the ElevenLabs agent.
# Legacy AIRA_CALL_SIGNING_SECRET and AIRA_REALTIME_BRIDGE_SECRET are unused by native calls.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Generate independent high-entropy secrets (at least 32 characters).
AIRA_SPEECH_SIGNING_SECRET=
AIRA_WORKER_SECRET=
# Exact origins only, comma separated. Add actual Firebase domain after setup.
AIRA_ALLOWED_ORIGINS=http://localhost:8080
